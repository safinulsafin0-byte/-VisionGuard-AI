# VisionGuard AI — Environment Configuration Template
# Copy this file to .env for local overrides. Never commit actual secret keys.

# Application Server
PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501

# Operational Safety Limits
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096

# AWS Cloud Deployment Placeholders (Do not insert real credentials here)
AWS_DEFAULT_REGION=us-east-1
AWS_ECR_REPOSITORY_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/visionguard-ai
AWS_ECS_CLUSTER=visionguard-cluster

